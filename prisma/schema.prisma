generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum GUEST {
  GROOM_GUEST
  BRIDE_GUEST
}

model Comment {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  guestName String   @map("guest_name")
  content   String

  @@map("comments")
}

model Confirmation {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  guestName String   @map("guest_name")
  type      GUEST    @default(GROOM_GUEST) @map("type")
  joinTime  String   @default("01/12/2023") @map("join_time")

  @@map("confirmations")
}
